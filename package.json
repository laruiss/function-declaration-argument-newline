{
  "name": "@laruiss/function-declaration-argument-newline",
  "version": "0.2.0",
  "description": "ESLint rules for line-break placement that the core stylistic rule set doesn't cover yet, starting with per-parameter newlines in function definitions.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.28.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laruiss/function-declaration-argument-newline.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin"
  ],
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0"
  },
  "devDependencies": {
    "@types/eslint": "^9.6.1",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "typescript": "~7.0.2"
  }
}
